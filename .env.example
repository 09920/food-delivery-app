# Database connection string
# Local zero-dependency SQLite:
DATABASE_URL="file:./dev.db"
# Neon / PostgreSQL:
# DATABASE_URL="postgresql://username:password@ep-sample-neon.aws.neon.tech/food_db?sslmode=require"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Authentication (Clerk optional; built-in persona switcher active)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Google Maps Platform (Geocoding, Distance, Directions)
GOOGLE_MAPS_API_KEY=""

# Email & SMS notifications
RESEND_API_KEY=""
MSG91_AUTH_KEY=""

# Redis (BullMQ / Live rider tracking)
REDIS_URL="redis://localhost:6379"

# Administrative & Security secrets
ADMIN_SECRET_KEY="replace_with_strong_secret"
